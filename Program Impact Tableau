            WHEN Sales_OU = 'AMER PACE' THEN 4
            WHEN Sales_OU = 'LATAM' THEN 5
            WHEN Sales_OU = 'EMEA South' THEN 6
            WHEN Sales_OU = 'UKI' THEN 7
            WHEN Sales_OU = 'EMEA Central' THEN 8
            WHEN Sales_OU = 'France' THEN 9
            WHEN Sales_OU = 'EMEA North' THEN 10
            WHEN Sales_OU = 'North Asia' THEN 11
            WHEN Sales_OU = 'South Asia' THEN 12
            WHEN Sales_OU = 'ANZ' THEN 13
            WHEN Sales_OU = 'SMB' THEN 14
            WHEN Sales_OU = 'PubSec+.org' THEN 15
            WHEN Sales_OU = 'Data Foundations' THEN 16
        END AS Ord_OU
    FROM renewal_detail
)

