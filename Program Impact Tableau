            WHEN ACCOUNT_LVL_3_USR_ROLE IN ('SASIA - EVP') THEN 'South Asia'
            WHEN ACCOUNT_LVL_4_USR_ROLE IN ('SMB - AMER - ESB - SVP') AND BOOK_OF_BUSINESS != 'MuleSoft' THEN 'SMB AMER ESB'
