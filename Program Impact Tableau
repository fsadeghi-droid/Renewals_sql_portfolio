            WHEN ACCOUNT_LVL_3_USR_ROLE IN ('EMEA - FRANCE - SLS - SVP') AND BOOK_OF_BUSINESS != 'MuleSoft' THEN 'France SLS'
            WHEN ACCOUNT_LVL_3_USR_ROLE IN ('EMEA - NORTH - BELUX - AVP') AND BOOK_OF_BUSINESS != 'MuleSoft' THEN 'EMEA North BELUX'
            WHEN ACCOUNT_LVL_3_USR_ROLE IN ('EMEA - NORTH - NL - SVP') AND BOOK_OF_BUSINESS != 'MuleSoft' THEN 'EMEA North NL'
            WHEN ACCOUNT_LVL_3_USR_ROLE IN ('EMEA - NORTH - NOR - SVP') AND BOOK_OF_BUSINESS != 'MuleSoft' THEN 'EMEA North NOR'
            WHEN ACCOUNT_LVL_3_USR_ROLE IN ('EMEA - NORTH - CH - SVP') AND BOOK_OF_BUSINESS != 'MuleSoft' THEN 'EMEA North CH'
            WHEN ACCOUNT_LVL_3_USR_ROLE IN ('ANZ - AU - CMRCL - MGR') AND BOOK_OF_BUSINESS != 'MuleSoft' THEN 'ANZ AU CMRCL'
