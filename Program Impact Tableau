    rd.ACCOUNT_LVL_6_USR_ROLE,
    rd.ACCOUNT_LVL_7_USR_ROLE,
    rd.renewal_manager,
    rd.rmm_first_name,
    rd.rmm_last_name,
    rd.rmm_full_name,
    rd.RENEWAL_30DE,
    rd.opportunity_type,
    cur.OPTY_STG_NM AS stage,
    cur.forcst_cat_cd AS Forecast_Category,
    rd.RENEWAL_KEY_RISK_CAT,
    rd.is_monday,
    ren.RENEWAL_FISCAL_YEAR,
    ren.RENEWAL_FISCAL_QTR,
    rd.RENEWAL_CLOSE_MONTH,
    rd.RENEWAL_CLSD_DT,
    CASE
        WHEN MONTH(rd.RENEWAL_CLSD_DT) = 1 THEN YEAR(rd.RENEWAL_CLSD_DT)
        ELSE YEAR(rd.RENEWAL_CLSD_DT) + 1
    END AS close_dt_fiscal_year,
    CASE
        WHEN MONTH(rd.RENEWAL_CLSD_DT) IN (2, 3, 4) THEN 'Q1'
        WHEN MONTH(rd.RENEWAL_CLSD_DT) IN (5, 6, 7) THEN 'Q2'
        WHEN MONTH(rd.RENEWAL_CLSD_DT) IN (8, 9, 10) THEN 'Q3'
        WHEN MONTH(rd.RENEWAL_CLSD_DT) IN (11, 12, 1) THEN 'Q4'
    END AS close_dt_fiscal_qtr,
    TO_CHAR(rd.RENEWAL_CLSD_DT, 'Mon') AS close_dt_calendar_month,
    rd.RENEWAL_CONTRACT_END_DATE,
    bdm.baseline_dt AS baseline_date,
    IFNULL(b.beginning_attrition, 0) AS beginning_attrition,
    IFNULL(cur.current_attrition, 0) AS current_attrition,


    -- RULE 1: Capping observed peak risk so it doesn't exceed contract ATR (RENEWAL_ATR_CONV)
    GREATEST(
        IFNULL(mr.max_risk_observed, 0), 
        -1 * ABS(IFNULL(rd.RENEWAL_ATR_CONV, 0))
    ) AS max_risk_observed,
    rd.RENEWAL_AMT_CONV,
    rd.RENEWAL_ATR_CONV,
    rd.RENEWAL_FCAST_ATTRITION_CONV,
    rd.CONV_SWING_AMT,
    rd.ROR_APPROVED_AMT,
    rd.current_dt,
    rd.create_dt
FROM target_list t
LEFT JOIN baseline_date_map bdm  ON t.opp_id_15 = bdm.opp_id_15
LEFT JOIN program_scope ps       ON t.opp_id_15 = ps.opp_id_15
LEFT JOIN program_list pl        ON t.opp_id_15 = pl.opp_id_15
LEFT JOIN opty_scope s           ON t.opp_id_15 = s.opp_id_15
LEFT JOIN beginning b            ON t.opp_id_15 = b.opp_id_15 AND b.baseline_dt = bdm.baseline_dt AND b.rn = 1
LEFT JOIN current_rec cur        ON t.opp_id_15 = cur.opp_id_15 AND cur.rn = 1
LEFT JOIN renewal_info ren       ON t.opp_id_15 = ren.opp_id_15 AND ren.rn = 1
LEFT JOIN renewal_detail rd      ON t.opp_id_15 = rd.opp_id_15
LEFT JOIN sales_leader_mapping m ON t.opp_id_15 = m.opp_id_15
LEFT JOIN max_risk mr            ON t.opp_id_15 = mr.opp_id_15
ORDER BY
    t.target_account_id,
    t.target_opportunity_id
