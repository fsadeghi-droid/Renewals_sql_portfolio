            WHEN ACCOUNT_LVL_3_USR_ROLE = 'AMER - REG - HLS - HC - SVP' AND BOOK_OF_BUSINESS != 'MuleSoft' THEN 'AMER REG HLS HC'
            WHEN ACCOUNT_LVL_3_USR_ROLE = 'AMER - REG - HLS - LS - ENTR - SVP' AND BOOK_OF_BUSINESS != 'MuleSoft' THEN 'AMER REG HLS LS ENTR'
            WHEN ACCOUNT_LVL_4_USR_ROLE = 'AMER - TMT - ENTR - SVP' AND BOOK_OF_BUSINESS != 'MuleSoft' THEN 'AMER TMT ENTR'
            WHEN ACCOUNT_LVL_3_USR_ROLE LIKE 'AMER - TMT - STRAT%' AND BOOK_OF_BUSINESS != 'MuleSoft' THEN 'AMER TMT STRAT'
            WHEN ACCOUNT_LVL_4_USR_ROLE = 'AMER - TMT - CMRCL - SVP' AND BOOK_OF_BUSINESS != 'MuleSoft' THEN 'AMER TMT CMRCL'
            WHEN ACCOUNT_LVL_3_USR_ROLE = 'AMER - CBS - ENTR - SVP' AND BOOK_OF_BUSINESS != 'MuleSoft' THEN 'AMER CBS ENTR'
            WHEN ACCOUNT_LVL_3_USR_ROLE = 'AMER - CBS - ENTR - TTH - AVP' AND BOOK_OF_BUSINESS != 'MuleSoft' THEN 'AMER CBS TTH ENTR'
            WHEN ACCOUNT_LVL_3_USR_ROLE = 'AMER - CBS - CMRCL - SVP' AND BOOK_OF_BUSINESS != 'MuleSoft' THEN 'AMER CBS CMRCL'
            WHEN ACCOUNT_LVL_3_USR_ROLE = 'AMER - PACE - CMRCL - SVP' AND BOOK_OF_BUSINESS != 'MuleSoft' THEN 'AMER PACE CMRCL'
            WHEN ACCOUNT_LVL_3_USR_ROLE = 'AMER - PACE - RCG - SVP' AND BOOK_OF_BUSINESS != 'MuleSoft' THEN 'AMER PACE RCG'
            WHEN ACCOUNT_LVL_3_USR_ROLE = 'AMER - PACE - MAE - ENTR - SVP' AND BOOK_OF_BUSINESS != 'MuleSoft' THEN 'AMER PACE MAE ENTR'
            WHEN ACCOUNT_LVL_3_USR_ROLE IN ('LATAM - BR - ENTR - SVP') AND BOOK_OF_BUSINESS != 'MuleSoft' THEN 'LATAM BR ENTR'
            WHEN ACCOUNT_LVL_3_USR_ROLE IN ('LATAM - MX - ENTR - SVP') AND BOOK_OF_BUSINESS != 'MuleSoft' THEN 'LATAM MX ENTR'
            WHEN ACCOUNT_LVL_3_USR_ROLE IN ('LATAM - CMRCL - SVP') AND BOOK_OF_BUSINESS != 'MuleSoft' THEN 'LATAM CMRCL'
            WHEN ACCOUNT_LVL_3_USR_ROLE IN ('LATAM - GRW - ENTR - AR - AVP') AND BOOK_OF_BUSINESS != 'MuleSoft' THEN 'LATAM GRW ENTR AR'
            WHEN ACCOUNT_LVL_3_USR_ROLE IN ('LATAM - GRW - ENTR - CL - PE - AVP') AND BOOK_OF_BUSINESS != 'MuleSoft' THEN 'LATAM GRW ENTR CL PE'
            WHEN ACCOUNT_LVL_3_USR_ROLE IN ('LATAM - GRW - ENTR - CO - AVP') AND BOOK_OF_BUSINESS != 'MuleSoft' THEN 'LATAM GRW ENTR CO'
            WHEN ACCOUNT_LVL_3_USR_ROLE LIKE 'LATAM - PS - NP%' AND BOOK_OF_BUSINESS != 'MuleSoft' THEN 'LATAM PS NP'
            WHEN ACCOUNT_LVL_3_USR_ROLE IN ('UKI - ENTR - EVP') AND BOOK_OF_BUSINESS != 'MuleSoft' THEN 'UKI ENTR'
            WHEN ACCOUNT_LVL_3_USR_ROLE IN ('UKI - CMRCL - SVP') AND BOOK_OF_BUSINESS != 'MuleSoft' THEN 'UKI CMRCL'
            WHEN ACCOUNT_LVL_3_USR_ROLE IN ('EMEA - CENTRAL - AT - AVP') AND BOOK_OF_BUSINESS != 'MuleSoft' THEN 'EMEA Central AT'
            WHEN ACCOUNT_LVL_4_USR_ROLE IN ('EMEA - CENTRAL - DE - CMRCL - MM - AVP') AND BOOK_OF_BUSINESS != 'MuleSoft' THEN 'EMEA Central DE CMRCL MM'
            WHEN ACCOUNT_LVL_4_USR_ROLE IN ('EMEA - CENTRAL - DE - V1 - SVP') AND BOOK_OF_BUSINESS != 'MuleSoft' THEN 'EMEA Central DE V1'
